# Copy this file to .env and change the passwords.
# .env is gitignored; this example file is committed.

# --- MySQL (source database, runs in Docker) ---
MYSQL_PORT=3307
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=energy_retail
MYSQL_ROOT_PASSWORD=change-me-root

# Used by the Python history generator and the simulator
MYSQL_APP_USER=retail_app
MYSQL_APP_PASSWORD=change-me-app

# Read-only user for Airbyte (created by mysql/init/02_airbyte_user.sh)
AIRBYTE_DB_USER=airbyte
AIRBYTE_DB_PASSWORD=change-me-airbyte
